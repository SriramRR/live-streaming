# Supabase Postgres connection
# Get both from: Supabase Dashboard -> Project Settings -> Database -> Connection string
# NOTE: URL-encode any special characters in the password (@ -> %40, # -> %23, etc.)

# Pooled connection (port 6543) - used by the app/Prisma Client at runtime
DATABASE_URL="postgresql://postgres.<project-ref>:<url-encoded-password>@<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection (port 5432) - used by Prisma for introspection/migrations
DIRECT_URL="postgresql://postgres.<project-ref>:<url-encoded-password>@<region>.pooler.supabase.com:5432/postgres"

PORT=5000

# Secret used to sign JWTs - generate your own long random string
JWT_SECRET=replace-with-a-long-random-string
# Token lifetime (optional, defaults to 7d)
JWT_EXPIRES_IN=7d
